# TitleMCP credentials.
#
# Most tools need none of these: OFAC screening, release search and tracking,
# property tax status, the municipal lien directory, the county auditor searches
# and the workflow tools all work with this file empty. Fill in only the lines
# for the tools you want.
#
# Copy this file to .env in the repository root, or better, have a secret
# manager put the variables in the server's environment (see
# docs/CONFIGURATION.md#credentials). Never commit .env.

# pacer_bankruptcy_search: a PACER account from pacer.uscourts.gov.
# Searches can be billed to it. Set QA_MODE=true with a QA account to test free.
TITLE_MCP_PACER_USERNAME=
TITLE_MCP_PACER_PASSWORD=
TITLE_MCP_PACER_CLIENT_CODE=
TITLE_MCP_PACER_QA_MODE=false

# hoa_contact_search: a SerpAPI key from serpapi.com.
TITLE_MCP_SERPAPI_API_KEY=

# parcel_lookup: a rotating proxy, written user:password@host without a port.
TITLE_MCP_SMART_PROXY=

# Exam extraction (a library service, not an MCP tool): an Anthropic API key.
TITLE_MCP_ANTHROPIC_API_KEY=

# Durable workflow state. Leave STATE_BACKEND=memory to keep state in memory.
TITLE_MCP_STATE_BACKEND=memory
TITLE_MCP_POSTGRES_DSN=

# Every other setting has a working default. They are listed in
# docs/CONFIGURATION.md.
